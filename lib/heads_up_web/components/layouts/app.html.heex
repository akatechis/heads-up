<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <img src={~p"/images/heads-up-logo.png"} width="150" />
      </a>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <.link navigate={~p"/incidents"} class="hover:text-zinc-700">
        incidents
      </.link>
      <.link navigate={~p"/effort"} class="hover:text-zinc-700">
        effort calculator
      </.link>
      <.link navigate={~p"/signup"} class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80">
        signup <span aria-hidden="true">&rarr;</span>
      </.link>
    </div>
  </div>
</header>
<main class="px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
